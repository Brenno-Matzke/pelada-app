PORT=3001
JWT_SECRET=troque-por-um-segredo-aleatorio-forte

# Banco de dados (Turso / libSQL). Se ficarem vazias, cai para um arquivo
# SQLite local (server/pelada.db) automaticamente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# E-mail (SendGrid) para o fluxo de "esqueci minha senha". Se ficarem
# vazias, o link de reset é apenas impresso no console do servidor.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# URL pública do frontend, usada para montar o link de redefinição de senha
FRONTEND_URL=http://localhost:5173

# Origem(ns) permitida(s) para CORS em produção, separadas por vírgula.
# Em branco/local, libera qualquer origem.
ALLOWED_ORIGINS=

# Notificações push (Web Push). Gere uma vez com:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Segredo pra proteger o endpoint de cron do lembrete de pagamento
CRON_SECRET=
